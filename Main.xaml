<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAP Screen Inspector" Width="1440" Height="920" MinWidth="1100" MinHeight="720" Background="#EEF2F6" FontFamily="Segoe UI" Foreground="#182B42" UseLayoutRounding="True">
<Window.Resources>
<SolidColorBrush x:Key="Accent" Color="#FFCC00"/>
<Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="Foreground" Value="#182B42"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#7B8EA6"/><Setter TargetName="B" Property="Opacity" Value=".85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#0B65C2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="ComboBox"><Setter Property="MinHeight" Value="38"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8"/></Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DEE8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="18"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EFF4F9"/><Setter Property="Padding" Value="10,12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="DataGridCell"><Setter Property="Padding" Value="8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="DataGridRow"><Setter Property="MinHeight" Value="40"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFF1AE"/><Setter Property="Foreground" Value="#182B42"/></Trigger></Style.Triggers></Style>
</Window.Resources>
<DockPanel>
<Border DockPanel.Dock="Top" Background="#222A32" BorderBrush="#FFCC00" BorderThickness="0,0,0,4" Padding="26,20">
<Grid><StackPanel><TextBlock Text="SAP Screen Inspector" Foreground="White" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Explore the screen. Find the controls. Build the automation." Foreground="#B8C5D3" Margin="0,6,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#33433E" CornerRadius="14" Padding="12,7"><TextBlock Text="&#x25CF;  Read-only inspection" Foreground="#A8E1C3"/></Border></Grid>
</Border>
<Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D5DEE8" BorderThickness="0,1,0,0" Padding="24,12"><TextBlock x:Name="Status" Text="Choose a SAP session to begin." TextWrapping="Wrap"/></Border>
<Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="22,0,22,14" Padding="14">
<DockPanel>
<Grid DockPanel.Dock="Top" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Step capture" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="StepStatus" Text="Start a sequence, then capture after each action in SAP." Foreground="#60748A" Margin="0,3,0,0"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StartSteps" Content="Start" Background="#FFCC00"/><Button x:Name="TakeStep" Content="Capture step"/><Button x:Name="StopSteps" Content="Stop"/><Button x:Name="NewSteps" Content="New"/><Button x:Name="ExportSteps" Content="Export steps..." Margin="0"/></StackPanel>
</Grid>
<Expander x:Name="StepExpander" Header="Timeline and action details" IsExpanded="False">
<Grid Height="155" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ListBox x:Name="StepList" DisplayMemberPath="Label" BorderBrush="#CBD5E1" Margin="0,0,16,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<TextBlock Text="Action leading to this screen" Foreground="#60748A" Margin="0,0,0,5"/><TextBlock Grid.Column="1" Text="Control used (previous or current screen)" Foreground="#60748A" Margin="12,0,0,5"/>
<ComboBox x:Name="StepAction" Grid.Row="1"/><ComboBox x:Name="StepControl" Grid.Row="1" Grid.Column="1" Margin="12,0,0,0" DisplayMemberPath="Label"/>
<TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Notes / key pressed (optional)" Foreground="#60748A" Margin="0,8,0,5"/>
<TextBox x:Name="StepNotes" Grid.Row="3" Grid.ColumnSpan="2" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
</Grid></Grid></Expander>
</DockPanel></Border>
<Grid Margin="22">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Style="{StaticResource Card}" Margin="0,0,0,14">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,18,0"><TextBlock Text="SAP SESSION" FontWeight="SemiBold" FontSize="11" Foreground="#60748A" Margin="0,0,0,7"/><ComboBox x:Name="Sessions" DisplayMemberPath="Label"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="Reload" Content="&#x21BB;  Reload sessions"/><Button x:Name="Capture" Content="&#x25CE;  Capture screen" Background="#FFCC00" FontWeight="SemiBold" Margin="0"/></StackPanel>
<StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,15,0,0"><CheckBox x:Name="Auto" Content="Auto-refresh every 3 seconds" VerticalAlignment="Center" Margin="0,0,25,0"/><CheckBox x:Name="Values" Content="Include screen values" VerticalAlignment="Center" Margin="0,0,25,0"/><TextBlock x:Name="Mode" Foreground="#60748A" Text="No recording events needed." VerticalAlignment="Center"/></StackPanel>
</Grid></Border>
<Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="14">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBox x:Name="Search" ToolTip="Search by ID, type, name, tooltip or included value"/><TextBlock x:Name="SearchHint" Text="Search controls by ID, name or type…" Foreground="#708399" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
<ComboBox x:Name="Types" Grid.Column="1" Margin="12,0"/><Button x:Name="Export" Grid.Column="2" Content="Export capture…" Margin="0"/>
</Grid></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="230" MinWidth="160"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="340" MinWidth="260"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Card}" Padding="12"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Screen structure" FontSize="17" FontWeight="SemiBold" Margin="5,4,0,15"/><TreeView x:Name="Tree" BorderThickness="0" Background="Transparent"/></DockPanel></Border>
<GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent"/>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="12"><DockPanel>
<Grid DockPanel.Dock="Top" Margin="5,4,5,15"><TextBlock Text="Controls" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="Count" HorizontalAlignment="Right" Foreground="#60748A" VerticalAlignment="Center"/></Grid>
<TextBlock DockPanel.Dock="Bottom" Text="New / changed markers compare captures in this session." Foreground="#60748A" FontSize="11" Margin="4,12,0,0"/>
<Grid><DataGrid x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="White" AlternatingRowBackground="#F7F9FC" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
<DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="145"/>
<DataGridTextColumn Header="Name / ID" Binding="{Binding Name}" Width="*" MinWidth="130"/>
<DataGridTextColumn Header="Change" Binding="{Binding Change}" Width="80"/>
</DataGrid.Columns></DataGrid>
<TextBlock x:Name="Empty" Text="Your SAP screen, mapped.&#10;&#10;Open the screen in SAP, then choose&#10;Capture screen to inspect its controls." TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#708399" FontSize="15" IsHitTestVisible="False"/>
</Grid></DockPanel></Border>
<GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" Background="Transparent"/>
<Border Grid.Column="4" Style="{StaticResource Card}"><DockPanel>
<StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><Button x:Name="CopyId" Content="Copy control ID" Background="#FFCC00" FontWeight="SemiBold" Margin="0,0,0,8"/><Button x:Name="CopyCode" Content="Copy read-only code" Margin="0"/></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Details" Margin="0,0,18,0"><TextBlock Text="Control details" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Select a control to see its ID and properties." TextWrapping="Wrap" Foreground="#708399" Margin="0,15,0,0"/></StackPanel></ScrollViewer>
</DockPanel></Border>
</Grid></Grid>
</DockPanel>
</Window>

