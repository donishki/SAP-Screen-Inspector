<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SAP Screen Inspector" Icon="pack://application:,,,/SAP-Screen-Inspector;component/app.ico" Width="1540" Height="1040" MinWidth="1280" MinHeight="900" Background="#F5F7FB" FontFamily="Segoe UI" FontSize="15" Foreground="#14243D" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#FFCC00" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="Foreground" Value="#182B42" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#7B8EA6" />
                <Setter TargetName="B" Property="Opacity" Value=".85" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Opacity" Value=".4" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="#0B65C2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="BorderBrush" Value="#CBD5E1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#678AB5" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                      <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#64748B" />
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="10,4,28,4" VerticalAlignment="Center" />
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                  <ScrollViewer>
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D5DEE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#EFF4F9" />
      <Setter Property="Padding" Value="10,12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="MinHeight" Value="36" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#FFF1AE" />
          <Setter Property="Foreground" Value="#182B42" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,10" />
      <Setter Property="Margin" Value="0,0,0,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="#FFF1B2" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="#E0C961" />
                <Setter TargetName="Row" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFF1B2" />
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
              <Border x:Name="Track" Width="48" Height="26" CornerRadius="13" Background="#D7DCE5">
                <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3" />
              </Border>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#FFCC00" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="#527DA8" />
                <Setter TargetName="Track" Property="BorderThickness" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value=".5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="PlainExpander" TargetType="Expander">
      <ContentPresenter Content="{TemplateBinding Content}" />
    </ControlTemplate>
  </Window.Resources>
  <DockPanel>
    <Border Background="#FAFBFD" Padding="20,12" BorderBrush="#D5DEE8" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image Source="pack://application:,,,/SAP-Screen-Inspector;component/app.ico" Width="32" Height="32" Margin="0,0,12,0" />
          <TextBlock Text="SAP Screen Inspector" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        <Border Background="#E7F5E9" CornerRadius="16" Padding="14,6" Grid.Column="1">
          <TextBlock Text="No SAP session" Foreground="#245D35" VerticalAlignment="Center" x:Name="ConnectionStatus" />
        </Border>
      </Grid>
    </Border>
    <Border Padding="20,8" BorderBrush="#D5DEE8" BorderThickness="0,0,0,1" DockPanel.Dock="Top">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#FFF2BB" BorderBrush="#FFCC00" BorderThickness="0,0,0,3" CornerRadius="6,6,0,0" Padding="18,8">
          <TextBlock Text="Workspace" FontSize="16" FontWeight="SemiBold" />
        </Border>
        <TextBlock x:Name="Mode" Foreground="#60748A" Text="Native SAP recording - no SAP actions are executed" VerticalAlignment="Center" Grid.Column="2" HorizontalAlignment="Right" FontSize="11" />
        <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0,0,0">
          <Button x:Name="OpenSession" Content="▱  Saved sessions" Background="Transparent" BorderBrush="Transparent" FontSize="16" />
          <Button x:Name="Settings" Content="⚙  Settings" Background="Transparent" BorderBrush="Transparent" FontSize="16" />
        </StackPanel>
        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=Settings}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
          <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="9" Padding="20" Width="320">
            <StackPanel>
              <TextBlock Text="Capture settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
              <CheckBox x:Name="Auto" Content="Auto-refresh" VerticalAlignment="Center" Margin="0" />
              <TextBlock Text="Auto-refresh updates controls every three seconds while step capture is stopped." TextWrapping="Wrap" Foreground="#64748B" Margin="0,12,0,0" />
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </Border>
    <Border Padding="20,10" BorderBrush="#D5DEE8" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Text="Choose a SAP session to begin." TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="Read-only inspection" Foreground="#64748B" Margin="18,0,0,0" Grid.Column="1" />
      </Grid>
    </Border>
    <Grid Margin="18,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Session" VerticalAlignment="Center" Margin="8,0,16,0" />
        <ComboBox x:Name="Sessions" DisplayMemberPath="Label" Grid.Column="1" />
        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Grid.Column="2">
          <Button x:Name="Reload" Content="↻" ToolTip="Reload sessions" FontSize="20" Padding="14,6" />
          <CheckBox x:Name="Values" Content="Screen values" VerticalAlignment="Center" Margin="20,0,24,0" Style="{StaticResource Switch}" />
          <Button x:Name="StartSteps" Content="Record" Background="#FFCC00" FontWeight="SemiBold" />
          <Button x:Name="TakeStep" Content="Capture next step" Background="White" FontWeight="SemiBold" ToolTip="Ctrl + Alt + F8" FontSize="16" Padding="18,10" />
          <Button x:Name="StopSteps" Content="■  Stop" />
        </StackPanel>
      </Grid>
      <Expander Header="Inspect screen controls (optional)" Grid.Row="1" IsExpanded="False" Margin="0,0,0,4">
      <Grid Height="300">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width=".85*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="1.6*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="16">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,16">
              <TextBlock Text="Screen structure" FontSize="20" FontWeight="Bold" Margin="0" />
            </Border>
            <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent">
              <TreeView.Resources>
                <Style TargetType="TreeViewItem">
                  <Setter Property="Padding" Value="3,5" />
                </Style>
              </TreeView.Resources>
            </TreeView>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16" Grid.Column="2">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,16">
              <TextBlock Text="Controls" FontSize="20" FontWeight="Bold" Margin="0" />
            </Border>
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Search" ToolTip="Search by ID, type, name, tooltip or included value" />
                <TextBlock x:Name="SearchHint" Text="⌕  Search controls…" Foreground="#708399" VerticalAlignment="Center" IsHitTestVisible="False" Margin="12,0" />
                <ComboBox x:Name="Types" Grid.Column="1" Margin="10,0,0,0" />
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0" DockPanel.Dock="Bottom">
                <Button x:Name="Capture" Content="Capture screen" Background="Transparent" FontWeight="SemiBold" FontSize="12" Padding="10,6" BorderBrush="Transparent" />
                <Button x:Name="Export" Content="Export capture" FontSize="12" Padding="10,6" BorderBrush="Transparent" Background="Transparent" />
                <TextBlock x:Name="Count" HorizontalAlignment="Right" Foreground="#60748A" VerticalAlignment="Center" />
              </StackPanel>
              <Grid>
                <DataGrid x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="White" AlternatingRowBackground="#F7F9FC" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" FontSize="14">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Control" Width="*" MinWidth="140">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" Foreground="#526781" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="155" />
                    <DataGridTemplateColumn Header="Status" Width="108">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Left">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="#EEF1F5" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Change}" Value="Changed">
                                    <Setter Property="Background" Value="#FFE687" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Change}" Value="New">
                                    <Setter Property="Background" Value="#DDF3E2" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" />
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="Empty" Text="Your SAP screen, mapped.&#10;&#10;Open the screen in SAP, then choose&#10;Capture screen to inspect its controls." TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#708399" FontSize="15" IsHitTestVisible="False" />
              </Grid>
            </DockPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16" Grid.Column="4">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="#E5E9F0" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,16">
              <TextBlock Text="Control details" FontSize="20" FontWeight="Bold" Margin="0" />
            </Border>
            <DockPanel>
              <UniformGrid Columns="2" Margin="0,16,0,0" DockPanel.Dock="Bottom">
                <Button x:Name="CopyId" Content="▣  Copy ID" Background="White" FontWeight="SemiBold" />
                <Button x:Name="CopyCode" Content="‹ ›  Copy code" />
              </UniformGrid>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Details" Margin="0,0,10,0">
                  <TextBlock Text="Control details" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="Select a control to see its ID and properties." TextWrapping="Wrap" Foreground="#708399" Margin="0,15,0,0" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </DockPanel>
        </Border>
        <GridSplitter Width="4" HorizontalAlignment="Center" Background="Transparent" Grid.Column="1" />
        <GridSplitter Width="4" HorizontalAlignment="Center" Background="Transparent" Grid.Column="3" />
      </Grid>
      </Expander>
      <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0" Grid.Row="2">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Captured steps" FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="StepStatus" Text="Press Record, work in SAP, then press Stop." Foreground="#60748A" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="11" />
            <Button x:Name="NewSteps" Content="New sequence" Grid.Column="2" Padding="10,5" />
          </Grid>
          <TextBlock DockPanel.Dock="Top" Text="1. Record    -    2. Perform all your steps in SAP    -    3. Stop and save" TextWrapping="Wrap" Foreground="#60748A" Margin="0,8,0,16" />
          <TextBlock DockPanel.Dock="Top" Text="SAP actions and entered values are recorded automatically. Passwords are omitted. SAP may deliver pending actions when you press Stop." TextWrapping="Wrap" Margin="0,0,0,16" />
          <Expander Header="Timeline and action details" IsExpanded="True" x:Name="StepExpander" Template="{StaticResource PlainExpander}">
            <Grid MinHeight="260" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".9*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.5*" />
              </Grid.ColumnDefinitions>
              <ListBox x:Name="StepList" BorderBrush="#CBD5E1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,16,0" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Border Background="#E9EDF3" CornerRadius="16" Width="30" Height="30" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Number, StringFormat=00}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="{Binding Screen.Session.Transaction}" Foreground="#64748B" FontSize="11" Margin="0,4,0,0" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid Margin="20,0" Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="40" />
                  <RowDefinition Height="40" />
                  <RowDefinition Height="40" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Action editor" FontWeight="SemiBold" Margin="0,0,0,8" Grid.ColumnSpan="2" />
                <TextBlock Text="Action" VerticalAlignment="Center" Grid.Row="1" />
                <ComboBox x:Name="StepAction" Grid.Row="1" Grid.Column="1" Margin="0,2" MinHeight="32" />
                <TextBlock Text="Control" VerticalAlignment="Center" Grid.Row="2" />
                <ComboBox x:Name="StepControl" DisplayMemberPath="Label" Grid.Row="2" Grid.Column="1" Margin="0,2" MinHeight="32" />
                <TextBlock Text="Value" VerticalAlignment="Center" Grid.Row="3" />
                <TextBox ToolTip="Text, combo key, True/False or SAP virtual key number (Enter = 0). Never enter passwords." x:Name="StepArgument" Grid.Row="3" Grid.Column="1" Margin="0,2" MinHeight="32" />
                <TextBlock Text="Notes" VerticalAlignment="Top" Margin="0,10,0,0" Grid.Row="4" />
                <TextBox x:Name="StepNotes" Height="100" VerticalAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Grid.Row="4" Grid.Column="1" Margin="0,2" MinHeight="32" />
              </Grid>
              <Grid Grid.Column="2" Margin="18,0,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Script preview (SAP GUI Scripting)" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Border Background="#13233C" CornerRadius="8" Padding="12" Grid.Row="1">
                  <RichTextBox x:Name="ScriptPreview" IsReadOnly="True" Background="Transparent" Foreground="#E7EEF8" BorderThickness="0" FontFamily="Consolas" FontSize="14" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Grid.Row="2">
                  <Button x:Name="ExportSteps" Content="Save script (.txt)" />
                  <Button x:Name="ExportJson" Content="Save session (.json)" Margin="8,0,0,0" />
                </StackPanel>
              </Grid>
              <Border Grid.Column="1" BorderBrush="#D8DFEA" BorderThickness="1,0,0,0" IsHitTestVisible="False" />
              <Border Grid.Column="2" BorderBrush="#D8DFEA" BorderThickness="1,0,0,0" IsHitTestVisible="False" />
            </Grid>
          </Expander>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>